{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": { "node": ">=22 <23", "npm": ">=10 <11" },
  "scripts": {
    "dev": "next dev",
    "clean:next-types": "node -e \"require('node:fs').rmSync('.next/dev/types',{recursive:true,force:true})\"",
    "build": "npm run clean:next-types && next build",
    "start": "node app.cjs",
    "start:e2e": "node -e \"process.env.PORT='3100'; require('./app.cjs')\"",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "bootstrap": "tsx src/scripts/seed-payload.ts",
    "seed": "npm run bootstrap",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "seo:inventory": "tsx src/scripts/generate-seo-migration-inventory.ts",
    "retention:purge": "tsx src/scripts/purge-expired-submissions.ts",
    "jobs:schedules": "payload jobs:handle-schedules",
    "jobs:run": "payload jobs:run",
    "jobs:scheduler": "node scripts/run-scheduler.mjs",
    "test": "vitest run",
    "test:integration": "tsx src/scripts/run-form-integration.ts",
    "test:core:integration": "tsx src/scripts/run-core-integration.ts",
    "test:seo:integration": "tsx src/scripts/run-seo-integration.ts",
    "test:seo:e2e": "tsx src/scripts/run-seo-e2e.ts",
    "lint": "eslint",
    "typecheck": "npm run clean:next-types && next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/translations": "3.88.0",
    "file-type": "^22.0.2",
    "graphql": "^17.0.2",
    "jszip": "^3.10.1",
    "next": "16.3.2",
    "payload": "^3.88.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
