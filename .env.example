# Required local runtime
DATABASE_URI=postgresql://payload:payload_local_only@127.0.0.1:5433/payload_starter
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-a-different-32-character-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional generic bootstrap values
PAYLOAD_ADMIN_EMAIL=admin@example.test
PAYLOAD_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
STARTER_SITE_NAME=Payload CMS Starter

# Optional runtime/integrations
DEPLOYMENT_ENV=development
REVALIDATION_SECRET=
PORT=3000

# Optional test controls
RUN_PAYLOAD_INTEGRATION=0
RUN_SEO_E2E=0
SEO_E2E_BASE_URL=http://127.0.0.1:3100
SEO_E2E_PORT=3100
SEO_INVENTORY_SITE_URL=http://localhost:3000
SCHEDULER_INTERVAL_MS=60000
