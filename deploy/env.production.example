# Required production runtime
DATABASE_URI=postgresql://payload:CHANGE_ME_USE_A_RANDOM_DATABASE_PASSWORD@postgres:5432/payload_starter
PAYLOAD_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
IP_HASH_SECRET=CHANGE_ME_USE_A_DIFFERENT_32_CHARACTER_SECRET
NEXT_PUBLIC_SITE_URL=https://cms.example.com
DEPLOYMENT_ENV=production

# PostgreSQL container
POSTGRES_DB=payload_starter
POSTGRES_USER=payload
POSTGRES_PASSWORD=CHANGE_ME_USE_A_RANDOM_DATABASE_PASSWORD

# Optional first bootstrap administrator
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
STARTER_SITE_NAME=Payload CMS Starter

# Optional signed cache revalidation endpoint
REVALIDATION_SECRET=

# Optional runtime/deployment settings
PORT=3000
WEB_PORT=3001
DEPLOY_BRANCH=main
SCHEDULER_INTERVAL_MS=60000
